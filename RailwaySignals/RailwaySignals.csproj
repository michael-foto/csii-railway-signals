<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Pinned, not derived from the project file name. Three things are keyed to this exact
		  string: the $type assembly reference in every Assets/**.Prefab, the toolchain's
		  DeployDir ($(LocalModsPath)\$(TargetName)), and the PDX publish configuration.
		  Renaming it stops the prefab tag component deserialising and orphans the installed mod.
		-->
		<AssemblyName>railway-signals</AssemblyName>
		<Configurations>Debug;Release</Configurations>
	
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
	</PropertyGroup>
	
	<!-- See README for the variables and where to set them.  -->
	<PropertyGroup>
		<CSII_AppId>949230</CSII_AppId>
		<!--Mod.props supplies the real one. Without a value the import below is never reached and an
		    unset CSII_TOOLPATH reads as NETSDK1013 rather than as the missing import it is-->
		<TargetFramework Condition="'$(CSII_TOOLPATH)' == ''">net48</TargetFramework>
	</PropertyGroup>
	<Import Project="$(CSII_TOOLPATH)/Mod.props" />
	<Import Project="$(CSII_TOOLPATH)/Mod.targets" />

	<PropertyGroup>
		<ManagedPath>$(CSII_MANAGEDPATH)</ManagedPath>
		<UserDataPath>$(CSII_USERDATAPATH)</UserDataPath>
		<LocalModsPath>$(CSII_LOCALMODSPATH)</LocalModsPath>
		<ModPostProcessorPath>$(CSII_MODPOSTPROCESSORPATH)/ModPostProcessor.exe</ModPostProcessorPath>
		<ModPublisherPath>$(CSII_MODPUBLISHERPATH)/ModPublisher.exe</ModPublisherPath>
		<MSCORLIBPath>$(CSII_MSCORLIBPATH)</MSCORLIBPath>
		<UnityModProjectPath>$(CSII_UNITYMODPROJECTPATH)</UnityModProjectPath>
		<EntitiesVersion>$(CSII_ENTITIESVERSION)</EntitiesVersion>
		<EntityPackagePath>$(UnityModProjectPath)/Library/PackageCache/com.unity.entities@$(EntitiesVersion)/Unity.Entities/SourceGenerators</EntityPackagePath>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedPath)</AssemblySearchPaths>
	</PropertyGroup>

	<Target Name="CheckToolchainEnvironment" BeforeTargets="CheckManagedPath">
		<Error Condition="'$(CSII_MANAGEDPATH)' == ''" Text="CSII_MANAGEDPATH is not set. See Building in the README for the variables the build reads." />
	</Target>

	<!--Reference/Analyzer items are additive, not override-by-name, so the empty-path items Mod.props already added above (from the broken lookup) must be stripped before re-adding the correct ones-->
	<ItemGroup>
		<Reference Remove="@(Reference)" />
		<Analyzer Remove="@(Analyzer)" />
		<Reference Include="$(MSCORLIBPath)">
			<Private>false</Private>
		</Reference>
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.SystemAPI.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.SystemAPI.QueryBuilder.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.LambdaJobs.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.Common.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.SystemAPI.Query.dll" />
		<Analyzer Include="$(EntityPackagePath)/SystemGenerator.EntityQueryBulkOperations.dll" />
		<Analyzer Include="$(EntityPackagePath)/AspectGenerator.dll" />
		<Analyzer Include="$(EntityPackagePath)/Common.dll" />
		<Analyzer Include="$(EntityPackagePath)/JobEntityGenerator.dll" />
		<Analyzer Include="$(EntityPackagePath)/Unity.Entities.Analyzer.dll" />
		<Analyzer Include="$(EntityPackagePath)/Unity.Entities.Analyzer.CodeFixes.dll" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<Target Name="CustomModPostProcessorConfig" AfterTargets="ModPostProcessorConfig">
		<PropertyGroup>
			<ModPostProcessorResponseFile>$(IntermediateOutputPath)ModPostProcessorArgs.rsp</ModPostProcessorResponseFile>
			<ModPostProcessorResponseFileFullPath>$([System.IO.Path]::GetFullPath('$(ModPostProcessorResponseFile)'))</ModPostProcessorResponseFileFullPath>
			<!-- Proton maps to the Z: drive -->
			<UnityModProjectWinPath>Z:$(UnityModProjectFullPath.Replace('/', '\'))</UnityModProjectWinPath>
		</PropertyGroup>
		<ItemGroup>
			<ModPostProcessorArgLines Remove="@(ModPostProcessorArgLines)" />
			<ModPostProcessorArgLines Include="PostProcess" />
			<ModPostProcessorArgLines Include="&quot;$(TargetPath)&quot;" />
			<ModPostProcessorArgLines Include="-u" />
			<ModPostProcessorArgLines Include="&quot;$(UnityModProjectWinPath)&quot;" />
			<ModPostProcessorArgLines Include="@(ReferencePath->'-r%0a&quot;%(Identity)&quot;')" />
			<ModPostProcessorArgLines Include="-p%0aWindows%0a-p%0amacOS%0a-p%0aLinux%0a-d%0a-v" />
		</ItemGroup>
		<WriteLinesToFile File="$(ModPostProcessorResponseFile)" Lines="@(ModPostProcessorArgLines)" Overwrite="true" />
		<PropertyGroup>
			<ModPostProcessorArgs>protontricks-launch --appid $(CSII_AppId) "$(ModPostProcessorFullPath)" "@$(ModPostProcessorResponseFileFullPath)"</ModPostProcessorArgs>
		</PropertyGroup>
	</Target>

	<Target Name="RunModPostProcessor" AfterTargets="AfterBuild" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)'">
		<Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found, please check the path: $(ModPostProcessorFullPath)" />
		<Message Text="Run post processor: $(ModPostProcessorArgs)" Importance="high" />
		<ItemGroup>
			<BurstOutput Include="$(TargetDir)$(TargetName)_win_x86_64.dll" />
			<BurstOutput Include="$(TargetDir)$(TargetName)_mac_x86_64.bundle" />
			<BurstOutput Include="$(TargetDir)$(TargetName)_linux_x86_64.so" />
		</ItemGroup>
		<!--Removed first so their presence afterwards can only mean this run produced them-->
		<Delete Files="@(BurstOutput)" />
		<Exec Command="$(ModPostProcessorArgs)" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="low" ConsoleToMSBuild="true">
			<Output TaskParameter="ConsoleOutput" ItemName="PostProcessorOutput" />
			<Output TaskParameter="ExitCode" PropertyName="PostProcessorExitCode" />
		</Exec>
		<Error Condition="!Exists('%(BurstOutput.Identity)')" Text="Post processor exited with $(PostProcessorExitCode) and did not write %(BurstOutput.Identity):%0a@(PostProcessorOutput, '%0a')" />
	</Target>

	<!--
	  The publisher has to run in the game's prefix: PDX.SDK registers DiskIODefaultWindows
	  unconditionally, so validating the content folder P/Invokes kernel32 and a host run dies there.
	  Launching the exe without protontricks lands it in the default wine prefix instead, which
	  carries the wrong .NET. Its arguments have to be Windows paths.
	-->
	<Target Name="CustomModPublisherConfig" AfterTargets="ModPublisherConfig">
		<PropertyGroup>
			<PublishConfigurationWinPath>Z:$(PublishConfigurationFullPath.Replace('/', '\'))</PublishConfigurationWinPath>
			<ContentWinPath>Z:$(ContentFullPath.Replace('/', '\'))</ContentWinPath>
			<ModPublisherArgs>protontricks-launch --appid $(CSII_AppId) "$(ModPublisherFullPath)" $(ModPublisherCommand) "$(PublishConfigurationWinPath)" -c "$(ContentWinPath)"</ModPublisherArgs>
		</PropertyGroup>
	</Target>

	<!--
	  The publisher reports why it failed on stdout and then exits non-zero, which the terminal
	  logger renders as a bare MSB3073 with the reason dropped. Folding the output into the error
	  itself is the only form that survives every renderer.
	-->
	<Target Name="RunModPublisher" AfterTargets="CustomModPublisherConfig">
		<Error Condition="!Exists('$(ModPublisherFullPath)')" Text="Mod publisher not found: $(ModPublisherFullPath)" />
		<Message Text="Run mod publisher: $(ModPublisherArgs)" Importance="high" />
		<Exec Command="$(ModPublisherArgs)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low">
			<Output TaskParameter="ConsoleOutput" ItemName="ModPublisherOutput" />
			<Output TaskParameter="ExitCode" PropertyName="ModPublisherExitCode" />
		</Exec>
		<Message Text="@(ModPublisherOutput, '%0a')" Importance="high" />
		<Error Condition="'$(ModPublisherExitCode)' != '0'" Text="Mod publisher exited with $(ModPublisherExitCode):%0a@(ModPublisherOutput, '%0a')" />
	</Target>

	<!-- Deploy just code changes by default. Only set this flag if making changes to the assets themselves -->
	<Target Name="DeployModAssets" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' And '$(DeployAssets)' == 'true'">
		<ItemGroup>
			<ModAsset Include="Assets\**\*" Exclude="Assets\**\*.md" />
		</ItemGroup>
		<Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(DeployDir)\Assets\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'@(ModAsset)' != ''" />
		<Message Text="Copied %(ModAsset.Identity)" Importance="normal" Condition="'@(ModAsset)' != ''" />
	</Target>
</Project>
