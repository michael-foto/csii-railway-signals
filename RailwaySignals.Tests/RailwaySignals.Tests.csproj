<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0, not the mod's net48: net48 compiles here but cannot run, because the only cached
      net48 test hosts are Windows executables.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>RailwaySignals.Tests</AssemblyName>
    <RootNamespace>RailwaySignals.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    Source linked rather than referenced. A net8.0 project cannot ProjectReference the net48 mod
    (NU1201), and referencing it would fire the toolchain's ClearOutput, ModPostProcessor (through
    Wine) and DeployWIP on every test run. Both files below are free of Unity types on purpose:
    NativeList cannot be allocated outside the game process, because UnsafeUtility.Malloc is a
    Unity engine internal call.
  -->
  <ItemGroup>
    <Compile Include="../RailwaySignals/Signalling/SignalAspects.cs" Link="Signalling/SignalAspects.cs" />
    <Compile Include="../RailwaySignals/Signalling/SignalRules.cs" Link="Signalling/SignalRules.cs" />
  </ItemGroup>

  <!-- Pinned exactly: these versions are in the local package cache, so restore stays offline. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
